# ==========================================
# Vercel Blob Storage Configuration
# ==========================================
# When deployed on Vercel with a connected Blob store, Vercel automatically sets this variable.
# For local development, copy this value from:
# Vercel Dashboard -> Storage -> [Your Store] -> Settings -> .env.local -> BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxxxx"

# ==========================================
# Admin Panel Authentication
# ==========================================
# Credentials for logging into /admin
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="your-strong-password-here"

# Secret used to sign session cookies (generate with `openssl rand -hex 32`)
ADMIN_SECRET="your-random-32-byte-secret"
